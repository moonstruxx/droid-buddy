{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "docs": {
      "path": "/home/bjoern/git/droid",
      "description": "Collection of relevant droid information like patches, documentation, related sw",
    },
   "docs": {
      "path": "/home/bjoern/git/droid/droid_man",
      "description": "droid manual converted to md / docx prefer this over pdf version"
    },
  },

  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "permission": {
    "skill": {
      "pc-*": "allow",
      "openspec-*": "allow"
    },
    "question": "allow",
    "todowrite": "allow"
  },
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "model": "opencode/Muse-Sparl-1.2 free",
  "plugin": [
    "@slkiser/opencode-quota@4.2.0"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}
